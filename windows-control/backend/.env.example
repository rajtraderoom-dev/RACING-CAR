# Developer-only host configuration. Windows setup uses the generated root .env
# and Docker Compose; it does not require editing this file.
DATABASE_URL=postgres://racing_api:YOUR_RANDOM_PASSWORD@127.0.0.1:5432/racing_speed_control
JWT_SECRET=GENERATE_AT_LEAST_64_RANDOM_HEX_CHARACTERS
NODE_ENV=development
LOCAL_CONTROL_PANEL=true
ALLOW_UNATTESTED_DEV=true
WEB_ORIGIN=https://localhost:8443
BOOTSTRAP_TOKEN_HASH=GENERATE_SHA256_OF_YOUR_PRIVATE_SETUP_CODE
# Optional private receipt storage: configure a scoped AWS identity separately.
# AWS_REGION=ap-south-1
# ATTACHMENT_BUCKET=YOUR_PRIVATE_BUCKET
# ATTACHMENT_KMS_KEY=YOUR_KMS_KEY_ARN
